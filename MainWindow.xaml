                                    <Grid Canvas.Left="2" Canvas.Top="7" Width="29" Height="13" Background="White">
                                        <Label Content="TH" Height="38" Margin="-2,-5,0,0" Padding="0" VerticalAlignment="Top" VerticalContentAlignment="Top" FontWeight="Bold" FontFamily="Consolas" FontSize="18" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <controls:NumericUpDown x:Name="StationScopeSignalStrengthThresholdNumericUpDown" Canvas.Left="30" Canvas.Top="0" Width="104" Height="10" Minimum="1" Maximum="60" Value="7" Interval="1"
                                        StringFormat="N0" UpDownButtonsWidth="30" FontSize="14" BorderThickness="0" Background="Transparent" Foreground="White"
                                        PreviewMouseUp="StationScopeSignalStrengthThresholdNumericUpDown_PreviewMouseUp">
                                    </controls:NumericUpDown>
                                    <Label Content="dB" Canvas.Left="130" Canvas.Top="0" Height="38" Margin="-1,2,0,0" Padding="0" Foreground="White" VerticalAlignment="Top" VerticalContentAlignment="Top" FontWeight="Bold" FontFamily="Consolas" FontSize="18" HorizontalAlignment="Center"/>

                                    <Label Canvas.Left="78" Canvas.Top="14" Content="1   3   5   7  9  20 40 60 dB" Foreground="White" FontWeight="Light" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right"/>
                                </Canvas>
                            </Border>
                            
                            <Border Canvas.Left="14" Canvas.Top="31" BorderThickness="1" BorderBrush="LightGray" Padding="0">
