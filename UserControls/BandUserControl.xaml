<UserControl x:Class="YAESU_FT_891_Front_End.BandUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YAESU_FT_891_Front_End"
             mc:Ignorable="d" 
             d:DesignHeight="126" d:DesignWidth="300">
    <Border x:Name="BandWindowBorder" Width="300" Panel.ZIndex="1" Height="126" CornerRadius="5" Background="Gray" Visibility="Visible">

            <Canvas>

                <TextBlock Text="BAND" Style="{StaticResource SimulatedWaterfallTextBlockStyle}" Width="290" Height="20" VerticalAlignment="Top" Margin="5,6,0,0" Foreground="White" Background="#666666"/>

                <Border x:Name="_1P8Border" Tag="0" Canvas.Left="2" Canvas.Top="34" Style="{StaticResource SimulatedWaterfallBorderStyle}" CornerRadius="3" Background="LightGray" MouseLeftButtonDown="BandWindowCanvas_MouseLeftButtonDown">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="_1P8TextBlock" Text="1.8" Style="{StaticResource SimulatedWaterfallTextBlockStyle}" Foreground="Black"/>
                    </StackPanel>
                </Border>
                <Border x:Name="_3P5Border" Tag="1" Canvas.Left="75" Canvas.Top="34" Style="{StaticResource SimulatedWaterfallBorderStyle}" CornerRadius="3" Background="LightGray" MouseLeftButtonDown="BandWindowCanvas_MouseLeftButtonDown">
