                        <TextBlock x:Name="_50TextBlock" Text="50" Style="{StaticResource SimulatedWaterfallTextBlockStyle}" Foreground="Black"/>
                    </StackPanel>
                </Border>
                <Border x:Name="_70GENBorder" Tag="11" Canvas.Left="221" Canvas.Top="100" Style="{StaticResource SimulatedWaterfallBorderStyle}" CornerRadius="3" Background="LightGray" MouseLeftButtonDown="BandWindowCanvas_MouseLeftButtonDown">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="_70GENTextBlock" Text="70/GEN" Style="{StaticResource SimulatedWaterfallTextBlockStyle}" Foreground="Black"/>
                    </StackPanel>
                </Border>

            </Canvas>

