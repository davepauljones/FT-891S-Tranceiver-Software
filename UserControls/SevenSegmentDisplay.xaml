<UserControl x:Class="YAESU_FT_891_Front_End.SevenSegmentDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YAESU_FT_891_Front_End"
             mc:Ignorable="d" 
             d:DesignHeight="166" d:DesignWidth="100" Background="#AA444444">
    <Canvas>
        <Viewbox Stretch="Uniform">
            <Canvas Width="100" Height="160">
                <Canvas.RenderTransform>
                    <SkewTransform AngleX="-7" CenterX="50" CenterY="80"/>
                </Canvas.RenderTransform>

                <Canvas.Resources>
                    <SolidColorBrush x:Key="SegmentOnBrush" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="SegmentOffBrush" Color="#333333"/>

                    <Style TargetType="Polygon">
                        <Setter Property="Fill" Value="{StaticResource SegmentOnBrush}"/>
                        <!--<Setter Property="Stroke" Value="{StaticResource SegmentOnBrush}"/>
                        <Setter Property="StrokeThickness" Value="0"/>-->
                        <Setter Property="StrokeLineJoin" Value="Round"/>
                    </Style>
                </Canvas.Resources>

                <Polygon x:Name="SegmentA" Points="11.5,10  88.5,10  76.5,22  23.5,22" />

                <Polygon x:Name="SegmentF" Points="10,11.5  22,23.5  22,74  10,82" />

                <Polygon x:Name="SegmentB" Points="90,11.5  90,82.1  78,74.1  78,23.5" />

                <Polygon x:Name="SegmentG" Points="11,84  23,76  77,76  89,84  77,92  23,92" />

                <Polygon x:Name="SegmentE" Points="10,86  22,94  22,144.5  10,156.5" />

                <Polygon x:Name="SegmentC" Points="90,86  90,156.5  78,144.5  78,94" />

                <Polygon x:Name="SegmentD" Points="23.5,146  76.5,146  88.5,158  11.5,158" />

                <Ellipse x:Name="SegmentDot" Canvas.Left="94" Canvas.Top="144" Width="14" Height="14" 
                         Fill="{StaticResource SegmentOnBrush}"/>

            </Canvas>
        </Viewbox>
    </Canvas>
</UserControl>
