<UserControl x:Class="YAESU_FT_891_Front_End.MorseCode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YAESU_FT_891_Front_End"
             mc:Ignorable="d" 
             d:DesignHeight="154" d:DesignWidth="643">
    <Canvas>

        <Canvas x:Name="FiltersCanvas" Style="{StaticResource TabCanvasStyle}" Background="#ff444444">
            <Canvas Canvas.Left="0" Canvas.Top="0">
                <StackPanel Orientation="Horizontal" Canvas.Left="2" Canvas.Top="0">
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Power:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="CWDecoderPowerTextBlock" Text="0.0" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tone:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="ToneStateTextBlock" Text="0" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dot:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="DotLengthTextBlock" Text="0" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dur:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="DurationTextBlock" Text="0" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sym:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="SymbolTextBlock" Text="-" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Out:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="LastDecodedTextBlock" Text="-" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="78"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stage:" Foreground="Orange"/>
                        <TextBlock Grid.Column="1" x:Name="StageTextBlock" Text="IDLE" Foreground="Gray" TextAlignment="Center"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer x:Name="CWDecoderScrollViewer" Canvas.Left="2" Canvas.Top="18" Width="638" Height="108" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="CWDecoderTextBlock" Text="CQ DX" Foreground="White" FontSize="24" TextWrapping="Wrap" Width="610" Padding="0,0,0,4" />
                </ScrollViewer>
                
            </Canvas>

        </Canvas>

        <Canvas>

            <Border Canvas.Left="-1" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" Width="20" CornerRadius="0,0,0,24" BorderThickness="0"/>

            <Border Tag="0" Canvas.Left="20" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="160M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="1.8Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="1" Canvas.Left="73" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="80M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="3.5Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="2" Canvas.Left="126" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="40M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="7Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="3" Canvas.Left="179" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="30M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="10Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="4" Canvas.Left="232" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="20M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="14Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="5" Canvas.Left="285" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="15M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="21Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="6" Canvas.Left="338" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="12M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="24.5Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="7" Canvas.Left="391" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="11M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="27Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="8" Canvas.Left="444" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="10M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="28Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="9" Canvas.Left="497" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="6M" Style="{StaticResource StationScopeButtonATextBlockStyle}" Foreground="White"/>
                    <TextBlock Text="50Mhz" Style="{StaticResource StationScopeButtonBTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>
            <Border Tag="10" Canvas.Left="550" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" Width="69" MouseLeftButtonDown="MorseCodeButtons_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="START" Style="{StaticResource SimulatedWaterfallTextBlockStyle}" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Canvas.Left="620" Canvas.Top="129" Style="{StaticResource StationScopeButtonBorderStyle}" Width="21" CornerRadius="0,0,24,0"/>

        </Canvas>

    </Canvas>

</UserControl>