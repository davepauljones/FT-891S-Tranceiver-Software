<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                    xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF">

    <Color x:Key="MenuShadowColor">#FFFFFFFF</Color>

    <Color x:Key="HighlightColor">#FF0050EF</Color>

    <Color x:Key="AccentColor">DodgerBlue</Color>
    <!--60%-->
    <Color x:Key="AccentColor2">#990050EF</Color>
    <!--40%-->
    <Color x:Key="AccentColor3">#660050EF</Color>
    <!--20%-->
    <Color x:Key="AccentColor4">#330050EF</Color>

    <Color x:Key="AccentColor5">#FF484848</Color>

    <!-- re-set brushes too -->
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentColorBrush2" Color="{StaticResource AccentColor2}"/>
    <SolidColorBrush x:Key="AccentColorBrush3" Color="{StaticResource AccentColor3}"/>
    <SolidColorBrush x:Key="AccentColorBrush4" Color="{StaticResource AccentColor4}"/>

    <SolidColorBrush x:Key="WindowTitleColorBrush" Color="GhostWhite" />

    <SolidColorBrush x:Key="AccentSelectedColorBrush" Color="White" />

    <LinearGradientBrush x:Key="ProgressBrush" EndPoint="0.001,0.5" StartPoint="1.002,0.5">
        <GradientStop Color="{StaticResource HighlightColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor3}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CheckmarkFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RightArrowFill" Color="{StaticResource AccentColor}" />

    <Color x:Key="IdealForegroundColor">#FF2b5797</Color>
    <SolidColorBrush x:Key="IdealForegroundColorBrush" Color="{StaticResource IdealForegroundColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
    <Style x:Key="UPASMetroWindowStyle2" TargetType="{x:Type Controls:MetroWindow}" BasedOn="{StaticResource {x:Type Controls:MetroWindow}}" >
        <Setter Property="SaveWindowPosition" Value="True"/>
    </Style>
    <Style x:Key="UPASMetroWindowStyle" TargetType="{x:Type Controls:MetroWindow}">
        <Setter Property="Icon" Value="pack://application:,,/Images/UPAS.ico"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="WindowTransitionsEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowState" Value="Normal"/>
        <Setter Property="ShowTitleBar" Value="True"/>
        <Setter Property="TitleForeground" Value="{DynamicResource UC_SolidColorBrush_Title_Foreground}"/>
        <Setter Property="ShowIconOnTitleBar" Value="True"/>
        <Setter Property="NonActiveGlowBrush" Value="Transparent"/>
        <Setter Property="NonActiveWindowTitleBrush" Value="{DynamicResource UC_SolidColorBrush_NonActiveWindowTitleBrush}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ShowCloseButton" Value="True"/>
        <Setter Property="ShowMaxRestoreButton" Value="True"/>
        <Setter Property="ShowMinButton" Value="True"/>

        <Setter Property="SaveWindowPosition" Value="True"/>

        <Setter Property="NonActiveBorderBrush" Value="Transparent"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="UPASFullScreenMetroWindowStyle" TargetType="{x:Type Controls:MetroWindow}">
        <Setter Property="Icon" Value="pack://application:,,/Images/UPAS.ico"/>
        <Setter Property="SizeToContent" Value="Manual"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="WindowTransitionsEnabled" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Red"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowState" Value="Normal"/>
        <Setter Property="ShowTitleBar" Value="True"/>
        <Setter Property="WindowTitleBrush" Value="#FF3e4045"/>
        <Setter Property="IgnoreTaskbarOnMaximize" Value="True"/>
        <Setter Property="TitleForeground" Value="Gray"/>
        <Setter Property="ShowIconOnTitleBar" Value="True"/>
        <Setter Property="NonActiveGlowBrush" Value="Transparent"/>
        <Setter Property="NonActiveWindowTitleBrush" Value="#FF2e2f33"/>

        <Setter Property="Width" Value="{Binding SystemParameters.WorkArea.Width}"/>
        <Setter Property="Height" Value="{Binding SystemParameters.WorkArea.Height}"/>
        <Setter Property="MaxWidth" Value="{Binding SystemParameters.WorkArea.Width}"/>
        <Setter Property="MaxHeight" Value="{Binding SystemParameters.WorkArea.Height}"/>

        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ShowCloseButton" Value="True"/>
        <Setter Property="ShowMaxRestoreButton" Value="False"/>
        <Setter Property="ShowMinButton" Value="True"/>

        <Setter Property="SaveWindowPosition" Value="True"/>

        <Setter Property="NonActiveBorderBrush" Value="Transparent"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

    <Style x:Key="CleanWindowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MetroWindowButtonStyle}">
        <Setter Property="Foreground" Value="Gray"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EB2F2F"/>
                <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#7C0000"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UXstyle" TargetType="{x:Type Controls:MetroWindow}">
        <Setter Property="Icon" Value="pack://application:,,/Images/UPAS.ico"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="WindowTransitionsEnabled" Value="False"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="WindowState" Value="Maximized"/>
        <Setter Property="ShowTitleBar" Value="False"/>
        <Setter Property="IgnoreTaskbarOnMaximize" Value="True"/>
        <Setter Property="ShowMaxRestoreButton" Value="False"/>
        <Setter Property="ShowMinButton" Value="False"/>
        <Setter Property="ShowCloseButton" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="FilmStripBorderStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="Black"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Margin" Value="0,32,0,0"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="14"/>
    </Style>
    <Style x:Key="FilmStripLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style x:Key="FilmStripLabelStyle2" TargetType="{x:Type Label}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Background" Value="#00000000"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style x:Key="FilmStripGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Margin" Value="15,62,13,0"/>
        <Setter Property="Width" Value="408"/>
        <Setter Property="Height" Value="272"/>
    </Style>
    <Style x:Key="FilmStripVerticalGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Margin" Value="16,8,13,0"/>
        <Setter Property="MaxWidth" Value="275"/>
        <Setter Property="Height" Value="335"/>
    </Style>
    <Style x:Key="FilmStripVerticalGridStyle2" TargetType="{x:Type Grid}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="MaxWidth" Value="272"/>
        <Setter Property="Height" Value="335"/>
    </Style>
    <Style x:Key="FilmStripHorizontalGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MaxWidth" Value="190"/>
        <Setter Property="Height" Value="240"/>
    </Style>
    <Style x:Key="FilmStripWindowCloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MetroWindowButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="Black"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CustomLabel"
