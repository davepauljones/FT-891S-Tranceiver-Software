    <!--UltraConnect base colors-->
    <SolidColorBrush x:Key="UC_SolidColorBrush_Window_Background" Color="DarkGray"/>
    <SolidColorBrush x:Key="UC_SolidColorBrush_Title_Foreground" Color="Black"/>
    <SolidColorBrush x:Key="UC_SolidColorBrush_NonActiveWindowTitleBrush" Color="Gainsboro"/>

    <RadialGradientBrush x:Key="GrayRadialGraadient" GradientOrigin=".25,.75" RadiusX="1.6" RadiusY=".6" Opacity="1">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF333333" Offset="0"></GradientStop>
            <GradientStop Color="Black" Offset="1"></GradientStop>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="GreenRadialGraadient" GradientOrigin=".25,.75" RadiusX="1.6" RadiusY=".6" Opacity="0.9">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF333333" Offset="0"></GradientStop>
            <GradientStop Color="#AF00FF00" Offset="1"></GradientStop>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BlueRadialGraadient" GradientOrigin=".25,.75" RadiusX="1.6" RadiusY=".6" Opacity="0.9">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF555555" Offset="0"></GradientStop>
            <GradientStop Color="LightSlateGray" Offset="1"></GradientStop>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="LightGrayRadialGraadient" GradientOrigin=".25,.75" RadiusX="1.6" RadiusY=".6" Opacity="1">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FF888888" Offset="0"></GradientStop>
            <GradientStop Color="LightGray" Offset="1"></GradientStop>
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Sample1" GradientOrigin="0.2, 0.2">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#FFFFFFFF" Offset="0.1" />
            <GradientStop Color="#0F0000FF" Offset="1.5" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Sample2" GradientOrigin="0.5, 0.9">
