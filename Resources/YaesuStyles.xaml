<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="YourNamespace.FunctionMenuResources">

    <Style x:Key="SimulatedWaterfallBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="74"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <Style x:Key="SimulatedWaterfallTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusBarTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="DodgerBlue"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="FunctionMenuBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Gray"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="ButtonLabelBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Width" Value="92"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="ButtonLabelLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="-1,-2,0,0"/>
    </Style>

    <Style x:Key="DisplayThreeCharBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    
    <Style x:Key="DisplayThreeCharLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="2"/>
    </Style>

    <Style x:Key="DisplayThreeCharSmallBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="DisplayThreeCharSmallLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="2,0,2,2"/>
    </Style>

    <Style x:Key="FunctionMenuTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,-1,0,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DisplayCanvasStyle" TargetType="{x:Type Canvas}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="643"/>
        <Setter Property="Height" Value="242"/>
    </Style>

    <Style x:Key="SignalBargraphRectangleStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="Orange"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="8"/>
    </Style>

    <Style x:Key="SignalBargraphLabelGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="Orange"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="8"/>
    </Style>

    <Style x:Key="SignalBargraphLabelLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="-1,-2,0,0"/>
    </Style>

</ResourceDictionary>